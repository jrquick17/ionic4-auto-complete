{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "inlineSources": true,
    "sourceMap": false
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "enableIvy": true,
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true
  }
}
